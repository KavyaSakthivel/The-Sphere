  {
    "source": "Curated, not crowded.",
    "pages": [
      "index.html"
    ]
  },
  {
    "source": "The Sphere is intentionally intimate.",
    "pages": [
      "index.html"
    ]
  },
  {
    "source": "We believe meaningful experiences happen when there is room to connect — with yourself and with others.",
    "pages": [
      "index.html"
    ]
  },
  {
    "source": "Every experience is thoughtfully curated around four elements:",
    "pages": [
      "index.html"
    ]
  },
  {
    "source": "MOVE  :  Movement that brings you back to your body.",
    "pages": [
      "index.html"
    ]
  },
  {
    "source": "PAUSE : Practices that create stillness in a world that rarely stops.",
    "pages": [
      "index.html"
    ]
  },
  {
    "source": "CONNECT : Conversations and experiences that bring women together beyond small talk.",
    "pages": [
      "index.html"
    ]
  },
  {
    "source": "DISCOVER :  New ideas, practices, perspectives and experiences that enrich the way you live.",
    "pages": [
      "index.html"
    ]
  },
  {
    "source": "MORE THAN WELLNESS",
    "pages": [
      "experiences/index.html"
    ]
  },
  {
    "source": "A community built around experiences.",
    "pages": [
      "experiences/index.html"
    ]
  },
  {
    "source": "At The Sphere, you might begin your morning with yoga, discover the grounding power of Kalaripayattu, experience the stillness of sound healing, or explore a completely new form of movement.",
    "pages": [
      "experiences/index.html"
    ]
  },
  {
    "source": "You might sit across from a woman you've never met and leave with a conversation you'll never forget.",
    "pages": [
      "experiences/index.html"
    ]
  },
  {
    "source": "Because sometimes wellness isn't about what you do.",
    "pages": [
      "experiences/index.html"
    ]
  },
  {
    "source": "It's about what you feel.",
    "pages": [
      "experiences/index.html"
    ]
  },
