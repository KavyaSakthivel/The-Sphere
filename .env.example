# Booking backend settings. Copy to .env for local development (npm run dev; .env is git-ignored).
# On Hostinger, set these in the website's Environment Variables instead. Never commit real values.

# Turns the booking API on. Without it the carnival page keeps using the shared Razorpay link.
BOOKINGS_ENABLED=false

# Razorpay: Account & Settings → API Keys. Use rzp_test_ keys until testing is signed off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook (Account & Settings → Webhooks).
RAZORPAY_WEBHOOK_SECRET=

# Meta: Events Manager → dataset 1150068800700841 → Settings → Conversions API → Generate access token.
META_ACCESS_TOKEN=
META_DATASET_ID=1150068800700841
# From Events Manager → Test Events while testing. Remove it for real sales.
META_TEST_EVENT_CODE=
# META_API_VERSION=v24.0

# MySQL (Hostinger: Databases → MySQL Databases). Tables are created on first start.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Local development only, instead of MySQL: keep bookings in a JSON file in this folder.
# DATA_DIR=.data
# SITE_URL=http://localhost:3000
